Screen {
    layout: vertical;
}

CollectionBar {
    dock: top;
    height: 1;
    background: $panel;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#scope-pane {
    width: 14;
    border-right: solid $accent;
}

#list-pane {
    width: 2fr;
    border-right: solid $accent;
}

#preview-pane {
    width: 3fr;
    padding: 0 1;
}

#scope-list {
    height: 1fr;
}

#meeting-list {
    height: 1fr;
}

#bottom-bar {
    dock: bottom;
    height: auto;
}

CommandBar {
    height: 1;
    display: none;
}

CommandBar #bar-row {
    height: 1;
}

CommandBar #bar-prefix {
    width: 1;
    color: $accent;
}

CommandBar Input {
    height: 1;
    border: none;
    padding: 0;
}

StatusBar {
    height: 1;
    background: $panel;
}

#editor {
    height: 1fr;
    width: 1fr;
}

#discard-dialog {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: thick $accent;
    align: center middle;
}

#discard-buttons {
    height: auto;
    align: center middle;
    padding-top: 1;
}

#discard-buttons Button {
    margin: 0 1;
}

DiscardDialog {
    align: center middle;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-pane {
    dock: bottom;
    height: 60%;
    width: 100%;
    background: $panel;
    border-top: thick $accent;
    padding: 1 2;
}

#help-body {
    height: 1fr;
}
