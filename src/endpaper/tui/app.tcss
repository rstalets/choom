Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#menu-pane {
    width: 14;
    border-right: solid $accent;
}

#list-pane {
    width: 2fr;
    border-right: solid $accent;
}

#preview-pane {
    width: 3fr;
    padding: 0 1;
}

#collection-menu {
    height: 1fr;
}

#meeting-list {
    height: 1fr;
}

#bottom-bar {
    dock: bottom;
    height: auto;
}

CommandBar {
    height: 1;
    display: none;
}

CommandBar Input {
    height: 1;
    border: none;
    padding: 0;
}

StatusBar {
    height: 1;
    background: $panel;
}

#editor {
    height: 1fr;
    width: 1fr;
}

#discard-dialog {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: thick $accent;
    align: center middle;
}

#discard-buttons {
    height: auto;
    align: center middle;
    padding-top: 1;
}

#discard-buttons Button {
    margin: 0 1;
}

DiscardDialog {
    align: center middle;
}
