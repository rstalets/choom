Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#menu-pane {
    width: 14;
    border-right: solid $accent;
}

#list-pane {
    width: 2fr;
    border-right: solid $accent;
}

#preview-pane {
    width: 3fr;
    padding: 0 1;
}

#collection-menu {
    height: 1fr;
}

#meeting-list {
    height: 1fr;
}

#bottom-bar {
    dock: bottom;
    height: auto;
}

CommandBar {
    height: 1;
    display: none;
}

CommandBar Input {
    height: 1;
    border: none;
    padding: 0;
}

StatusBar {
    height: 1;
    background: $panel;
}
