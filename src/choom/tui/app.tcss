Screen {
    layout: vertical;
}

CollectionBar {
    dock: top;
    height: 1;
    background: $panel;
}

#body {
    height: 1fr;
    layout: horizontal;
}

/* 020-vertical-tui-mode: added variant, base #body rule above is untouched
   (FR-020). Selects the vertical arrangement only; every rule below scoped
   under `.-vertical` likewise leaves its horizontal counterpart alone. */
#body.-vertical {
    layout: vertical;
}

/* 020-vertical-tui-mode: new -- vertical only. Groups the scope pane and the
   record list side by side so the preview can span beneath both. */
#upper-band {
    height: 1fr;
    layout: horizontal;
}

#scope-pane {
    width: 14;
    border-right: solid $accent;
}

#list-pane {
    width: 2fr;
    border-right: solid $accent;
}

/* 020-vertical-tui-mode: vertical only -- #list-pane is rightmost in the
   upper band there, not bordering the preview pane. */
#body.-vertical #list-pane {
    border-right: none;
}

#preview-pane {
    width: 3fr;
    padding: 0 1;
}

/* 020-vertical-tui-mode: vertical only -- full width beneath the upper band
   rather than a fraction of a horizontal row, with a divider on top instead
   of a side border. */
#body.-vertical #preview-pane {
    width: 1fr;
    height: 1fr;
    border-top: solid $accent;
}

#scope-list {
    height: 1fr;
}

#list-header {
    height: 1;
    background: $panel;
    text-style: bold;
}

#meeting-list {
    height: 1fr;
}

#bottom-bar {
    dock: bottom;
    height: auto;
}

#preview-links-section {
    dock: bottom;
    height: auto;
    max-height: 12;
    border-top: solid $accent;
}

/* 020-vertical-tui-mode, FR-043: the fixed `max-height: 12` above is a
   modest slice of a full-height horizontal preview pane, but would consume
   the *entire* lower band at 80x24 in vertical, leaving no preview visible.
   Bound as a fraction of the band instead of a fixed row count. */
#body.-vertical #preview-links-section {
    max-height: 50%;
}

#preview-links-list {
    height: auto;
    max-height: 10;
}

#links-section {
    height: auto;
    max-height: 12;
    border-top: solid $accent;
}

#links-list {
    height: auto;
    max-height: 10;
}

#link-picker {
    height: auto;
    max-height: 8;
    border-top: solid $accent;
}

CommandBar {
    height: 1;
    display: none;
}

CommandBar #bar-row {
    height: 1;
}

CommandBar #bar-prefix {
    width: 1;
    color: $accent;
}

CommandBar Input {
    height: 1;
    border: none;
    padding: 0;
}

StatusBar {
    height: 1;
    background: $panel;
}

#editor {
    height: 1fr;
    width: 1fr;
}

EditorPane {
    height: 1fr;
    width: 1fr;
}

#confirm-dialog {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: thick $accent;
    align: center middle;
}

ConfirmDialog {
    align: center middle;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-pane {
    dock: bottom;
    height: 60%;
    width: 100%;
    background: $panel;
    border-top: thick $accent;
    padding: 1 2;
}

#help-body {
    height: 1fr;
}
